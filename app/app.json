{
  "expo": {
    "name": "Hunch",
    "slug": "hunch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hunch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hunch.app",
      "icon": "./assets/images/icon.png",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Hunch to access your camera to capture photos and videos for your thoughts.",
        "NSMicrophoneUsageDescription": "Allow Hunch to access your microphone for voice notes.",
        "NSPhotoLibraryUsageDescription": "Allow Hunch to access your photos to attach them to your thoughts.",
        "NSPhotoLibraryAddUsageDescription": "Allow Hunch to save photos to your library.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.hunch.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FAF8F5"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1A1A1A",
            "image": "./assets/images/icon.png",
            "imageWidth": 120
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hunch to access your camera to capture photos and videos for your thoughts.",
          "microphonePermission": "Allow Hunch to access your microphone for voice notes.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Hunch to access your photos to attach them to your thoughts.",
          "savePhotosPermission": "Allow Hunch to save photos to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hunch to access your photos to attach them to your thoughts."
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0e21c852-a68d-4768-9fbd-9927514ebb52"
      }
    },
    "owner": "alen899993"
  }
}
